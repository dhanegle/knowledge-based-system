# 知源 配置文件 — 复制为 .env 后填写
# 所有变量前缀为 ZHIYUAN_

# 应用
ZHIYUAN_APP_NAME=知源
ZHIYUAN_DEBUG=false
ZHIYUAN_HOST=0.0.0.0
ZHIYUAN_PORT=8000

# LLM（OpenAI 兼容接口）
ZHIYUAN_LLM_BASE_URL=
ZHIYUAN_LLM_API_KEY=
ZHIYUAN_LLM_MODEL=
ZHIYUAN_LLM_MAX_TOKENS=4096
ZHIYUAN_LLM_TIMEOUT=120
# LLM 客户端实现：native（默认，openai SDK 直连）或 langchain（ChatOpenAI 适配器）
ZHIYUAN_LLM_BACKEND=native

# 图片页视觉识别 — 复用 LLM 配置；模型需支持视觉输入（step-3.7-flash 已验证）
# 留空使用 ZHIYUAN_LLM_MODEL；max_pages 限制单文档识别请求数，控制 API 成本
ZHIYUAN_VISION_MODEL=
ZHIYUAN_VISION_MAX_PAGES=20

# Embedding（OpenAI 兼容接口）
ZHIYUAN_EMBEDDING_BASE_URL=
ZHIYUAN_EMBEDDING_API_KEY=
ZHIYUAN_EMBEDDING_MODEL=
ZHIYUAN_EMBEDDING_DIM=768
# Embedding 客户端实现：native（默认，httpx 直连）或 langchain（OpenAIEmbeddings 适配器）
ZHIYUAN_EMBEDDING_BACKEND=native

# Qdrant
ZHIYUAN_QDRANT_URL=http://localhost:6333
ZHIYUAN_QDRANT_COLLECTION=zhiyuan_chunks

# Postgres
ZHIYUAN_DATABASE_URL=postgresql+asyncpg://zhiyuan:zhiyuan_dev@localhost:5432/zhiyuan

# 摄入管线
ZHIYUAN_CHUNK_SIZE=500
ZHIYUAN_CHUNK_OVERLAP=50

# 检索与重排
# 两段式检索：向量召回 RETRIEVAL_TOP_K 条 → 重排取 RERANK_TOP_K 条注入上下文
ZHIYUAN_RETRIEVAL_TOP_K=20
ZHIYUAN_RERANK_TOP_K=5
# 重排融合权重（最终会归一化为凸组合）：final = w_vec*归一化向量分 + w_kw*关键词命中率
# 默认 0.7/0.3 为语义主导，适合通用问答；
# 专有名词、术语、编号类检索建议调高关键词权重（如 0.3/0.7），
# 因为 min-max 归一化会放大"高相似却离题"的风险，需要关键词项纠偏。
ZHIYUAN_RERANK_VECTOR_WEIGHT=0.7
ZHIYUAN_RERANK_KEYWORD_WEIGHT=0.3
# 中文 2-gram 语料过滤：丢弃候选语料中未出现的跨词边界假二元组（如「档摄」「入失」）
ZHIYUAN_RERANK_FILTER_BIGRAMS=true

# 重排实现：keyword（默认，纯本地计算）或 model（交叉编码器，精度更高）
# 选 model 时下面三项必须全部填上，否则启动告警并自动降级为 keyword。
# 调用失败也会逐次降级，不会让问答报错。
ZHIYUAN_RERANK_BACKEND=keyword
#
# 模型重排走通用的 POST {BASE_URL}/rerank 形状，换供应商只改这三行。
# 已验证兼容该形状的服务：Cohere、Jina、SiliconFlow、HuggingFace TEI、Xinference。
# 常见中文模型：BAAI/bge-reranker-v2-m3、BAAI/bge-reranker-large、jina-reranker-v2
#
# 请求：{"model": "...", "query": "...", "documents": [...], "top_n": 5}
# 响应：{"results": [{"index": 2, "relevance_score": 0.91}, ...]}
#
# 例（SiliconFlow）：
#   ZHIYUAN_RERANK_BASE_URL=https://api.siliconflow.cn/v1
#   ZHIYUAN_RERANK_MODEL=BAAI/bge-reranker-v2-m3
ZHIYUAN_RERANK_BASE_URL=
ZHIYUAN_RERANK_API_KEY=
ZHIYUAN_RERANK_MODEL=
ZHIYUAN_RERANK_TIMEOUT=30

# 可观测性 — Langfuse（可选，留空则只用 structlog 日志；ZHIYUAN_LLM_BACKEND=langchain 时整链自动上报 trace）
ZHIYUAN_LANGFUSE_BASE_URL=
ZHIYUAN_LANGFUSE_PUBLIC_KEY=
ZHIYUAN_LANGFUSE_SECRET_KEY=

# 鉴权 — JWT（生产环境务必修改 jwt_secret）
ZHIYUAN_JWT_SECRET=zhiyuan-dev-secret-change-in-production
ZHIYUAN_JWT_ALGORITHM=HS256
ZHIYUAN_JWT_EXPIRE_MINUTES=1440

# 缓存 — Redis（可选，不可用时自动降级）
ZHIYUAN_REDIS_URL=redis://localhost:6379/0
ZHIYUAN_CACHE_TTL=3600
