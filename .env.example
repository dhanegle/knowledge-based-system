# 知源 配置文件 — 复制为 .env 后填写
# 所有变量前缀为 ZHIYUAN_

# 应用
ZHIYUAN_APP_NAME=知源
ZHIYUAN_DEBUG=false
ZHIYUAN_HOST=0.0.0.0
ZHIYUAN_PORT=8000

# LLM（OpenAI 兼容接口）
ZHIYUAN_LLM_BASE_URL=
ZHIYUAN_LLM_API_KEY=
ZHIYUAN_LLM_MODEL=
ZHIYUAN_LLM_MAX_TOKENS=4096
ZHIYUAN_LLM_TIMEOUT=120
# LLM 客户端实现：native（默认，openai SDK 直连）或 langchain（ChatOpenAI 适配器）
ZHIYUAN_LLM_BACKEND=native

# Embedding（OpenAI 兼容接口）
ZHIYUAN_EMBEDDING_BASE_URL=
ZHIYUAN_EMBEDDING_API_KEY=
ZHIYUAN_EMBEDDING_MODEL=
ZHIYUAN_EMBEDDING_DIM=768
# Embedding 客户端实现：native（默认，httpx 直连）或 langchain（OpenAIEmbeddings 适配器）
ZHIYUAN_EMBEDDING_BACKEND=native

# Qdrant
ZHIYUAN_QDRANT_URL=http://localhost:6333
ZHIYUAN_QDRANT_COLLECTION=zhiyuan_chunks

# Postgres
ZHIYUAN_DATABASE_URL=postgresql+asyncpg://zhiyuan:zhiyuan_dev@localhost:5432/zhiyuan

# 摄入管线
ZHIYUAN_CHUNK_SIZE=500
ZHIYUAN_CHUNK_OVERLAP=50

# 可观测性 — Langfuse（可选，留空则只用 structlog 日志；ZHIYUAN_LLM_BACKEND=langchain 时整链自动上报 trace）
ZHIYUAN_LANGFUSE_BASE_URL=
ZHIYUAN_LANGFUSE_PUBLIC_KEY=
ZHIYUAN_LANGFUSE_SECRET_KEY=

# 鉴权 — JWT（生产环境务必修改 jwt_secret）
ZHIYUAN_JWT_SECRET=zhiyuan-dev-secret-change-in-production
ZHIYUAN_JWT_ALGORITHM=HS256
ZHIYUAN_JWT_EXPIRE_MINUTES=1440

# 缓存 — Redis（可选，不可用时自动降级）
ZHIYUAN_REDIS_URL=redis://localhost:6379/0
ZHIYUAN_CACHE_TTL=3600
